# ── Admin session signing ───────────────────────────────────────────────────
# 32+ random bytes (`openssl rand -hex 32`). Required in production.
# Signs the HttpOnly admin session cookie; rotating it invalidates live sessions.
ADMIN_SESSION_SECRET=

# ── Supabase (shared with the main Owltside web app) ────────────────────────
# Required for BOTH admin authentication (Email 6-digit OTP + Google OAuth) and
# live platform data. There are no hardcoded or environment-based admin logins:
# only users whose `public.profiles.role` is `'superadmin'` or `'admin'` are
# permitted to sign in.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Links ───────────────────────────────────────────────────────────────────
# Customer-facing app this control plane governs (shown in the sidebar).
PUBLIC_APP_URL=http://localhost:5173

# NODE_ENV=development
