# ── Credentials ─────────────────────────────────────────────────────────────
# Both are required — the admin console no longer ships with demo seed data.
# The password must be 16+ characters.
ADMIN_EMAIL=admin@owltside.com
ADMIN_PASSWORD=

# 32+ random bytes. Signs the HttpOnly session cookie. Rotating it invalidates
# every live admin session — that is the intended kill switch.
ADMIN_SESSION_SECRET=

# ── Supabase (public web app database) ──────────────────────────────────────
# REQUIRED. The admin console reads and writes ALL platform data directly
# against the public web app's Supabase project using the service-role key.
# This is the same database the customer-facing Owltside app uses — there is
# no separate admin datastore, no fallback, no seeded dataset.
#
# PUBLIC_SUPABASE_URL is typically already set by the public app's .env;
# SUPABASE_SERVICE_ROLE_KEY is server-only and must never be exposed through
# PUBLIC_ or to the browser (it bypasses all RLS policies).
PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Links ───────────────────────────────────────────────────────────────────
# Customer-facing app this control plane governs (shown in the sidebar).
PUBLIC_APP_URL=http://localhost:5173

# NODE_ENV=development
