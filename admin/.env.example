# ── Credentials ─────────────────────────────────────────────────────────────
# Leave both empty to boot in DEMO MODE (pre-filled passphrase, seeded data).
# In production BOTH are required; the password must be 16+ characters.
ADMIN_EMAIL=admin@owltside.com
ADMIN_PASSWORD=

# 32+ random bytes. Signs the HttpOnly session cookie. Rotating it invalidates
# every live admin session — that is the intended kill switch.
ADMIN_SESSION_SECRET=

# ── Supabase (live data for the whole console) ──────────────────────────────
# Fill BOTH to read the real database: events, organizers, users, dashboard
# metrics, the organizer submission queue, approvals and content reports.
# Approving an event writes events.status='published' with the service-role key,
# which is what the public home/explore feeds read.
# Leave empty to run on the seeded demo dataset instead.
#
# PUBLIC_SUPABASE_URL (the variable the public app uses) is accepted here too,
# so a single repository-root .env can serve both apps — in development this
# console reads admin/.env first and then the root .env.
#
# The key MUST be the service-role key (Supabase → Settings → API → service_role,
# or an sb_secret_… key). The public anon / sb_publishable_ key is refused: RLS
# would filter every admin view and auth.admin.* calls would be rejected.
#
# The service-role key bypasses row-level security. Keep it server-side only —
# never expose it through PUBLIC_ or to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Links ───────────────────────────────────────────────────────────────────
# Customer-facing app this control plane governs (shown in the sidebar).
PUBLIC_APP_URL=http://localhost:5173

# NODE_ENV=development 