# ── Credentials ─────────────────────────────────────────────────────────────
# Leave both empty to boot in DEMO MODE (pre-filled passphrase, seeded data).
# In production BOTH are required; the password must be 16+ characters.
ADMIN_EMAIL=admin@owltside.com
ADMIN_PASSWORD=

# 32+ random bytes. Signs the HttpOnly session cookie. Rotating it invalidates
# every live admin session — that is the intended kill switch.
ADMIN_SESSION_SECRET=

# ── Supabase admin data (server-only) ────────────────────────────────────────
# Required for live event registry and dashboard metrics. Use the same project
# as the customer app; NEVER expose either key to browser code. The service-role
# key bypasses the app's organizer-scoped RLS policies.
PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# New Supabase projects may issue a secret key instead of service_role JWT:
# SUPABASE_SECRET_KEY=

# ── Links ───────────────────────────────────────────────────────────────────
# Customer-facing app this control plane governs (shown in the sidebar).
PUBLIC_APP_URL=http://localhost:5173

# NODE_ENV=development 