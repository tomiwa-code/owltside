# ── Supabase ────────────────────────────────────────────────────────────────
# Both values are required in production: the app refuses to boot without them.
# Schema lives in supabase/sql (000_full_schema.sql is the all-in-one file).
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# Service role key. Used only server-side, for the Paystack webhook, scanner
# throttling and admin reconciliation. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Demo / sandbox ──────────────────────────────────────────────────────────
# Demo mode mints local tickets with no gateway and accepts any login code.
# It is OFF by default and can never switch on by accident in production:
# it requires an explicit `true` here AND no Supabase configuration.
# Leave empty in production.
DEMO_MODE=
PUBLIC_DEMO_MODE=

# ── Paystack ────────────────────────────────────────────────────────────────
# Secret key (sk_test_… / sk_live_…). Checkout creates a pending order and
# redirects to the hosted Paystack page; the amount is computed by the
# database, never by the browser. Without this key, card checkout returns 503
# instead of falling back to a "simulated" success.
PAYSTACK_SECRET_KEY=
PUBLIC_PAYSTACK_PUBLIC_KEY=
# Point the Paystack dashboard webhook at: {PUBLIC_APP_URL}/api/paystack/webhook
# It must receive the RAW request body; the signature is verified with the key above.

# ── App ─────────────────────────────────────────────────────────────────────
PUBLIC_APP_URL=http://localhost:5173
# Internal admin control plane (separate SvelteKit app in ./admin).
PUBLIC_ADMIN_URL=http://localhost:5174

# ── Ticket pass signing ─────────────────────────────────────────────────────
# HMAC key for the rotating QR token (`owltside://t/<code>?s=<sig>`). Required
# in production; rotate to invalidate every outstanding pass.
QR_SIGNING_SECRET=dev-only-change-me

# ── Biometric passkeys ──────────────────────────────────────────────────────
# Encrypts the stored passkey vault cookie. Required in production (generate
# with `openssl rand -hex 32`). Never fall back to a public value here.
BIOMETRIC_SECRET=

# ── Scanner hardening ───────────────────────────────────────────────────────
# Pepper mixed into staff/gate PIN hashes before storage. Set a long random
# value in production so a leaked hash table cannot be brute-forced (a 6-digit
# PIN space is tiny). Rotating it invalidates outstanding PINs by design.
STAFF_PIN_PEPPER=

# ── Web Push ────────────────────────────────────────────────────────────────
# Push endpoints are validated against a built-in allowlist (FCM, Mozilla,
# WNS, Apple, Yandex) to prevent server-side request forgery. Add extra
# comma-separated host suffixes here only for a push service you trust.
PUSH_ENDPOINT_ALLOWLIST=
