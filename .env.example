# ── Supabase ────────────────────────────────────────────────────────────────
# Leave both empty to run in DEMO MODE (local seed data, simulated auth/payments).
# Paste your project keys to go live. Schema lives in supabase/sql/*.sql.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Paystack ────────────────────────────────────────────────────────────────
# Secret key (sk_test_… / sk_live_…). When absent, checkout runs the built-in
# approve / 3-D Secure / decline simulator.
PAYSTACK_SECRET_KEY=
PUBLIC_PAYSTACK_PUBLIC_KEY=

# ── App ─────────────────────────────────────────────────────────────────────
PUBLIC_APP_URL=http://localhost:5173
# Shared secret used to sign rotating ticket QR tokens server-side.
QR_SIGNING_SECRET=dev-only-change-me
